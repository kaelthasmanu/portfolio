---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
	typewriterText?: string;
}

const { align = 'center', tagline, title, typewriterText } = Astro.props;
---

<header class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		<h1 class="title">
			{title}
			{typewriterText ? (
				<>
					<span class="gradient-text" id="hero-typewriter" data-text={typewriterText}></span>
					<span class="cursor">|</span>
				</>
			) : null}
		</h1>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</header>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
		animation: fadeInUp 0.8s ease-out both;
	}

	.title,
	.tagline {
		max-width: 40ch;
		margin-inline: auto;
	}

	.title {
		font-size: var(--text-3xl);
		color: var(--gray-0);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 0.25em;
	}

	.gradient-text {
		background: var(--gradient-hero);
		background-size: 200% auto;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: shimmer 4s linear infinite;
	}

	.cursor {
		display: inline-block;
		color: var(--accent2-regular);
		animation: pulse-glow 1s step-end infinite;
		font-weight: 300;
		margin-left: -0.1em;
	}

	.tagline {
		color: var(--gray-300);
		font-size: var(--text-md);
		line-height: 1.6;
		animation: fadeInUp 0.8s ease-out 0.3s both;
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: left;
		}

		.start .title,
		.start .tagline {
			margin-inline: unset;
		}

		.start .title {
			justify-content: flex-start;
		}

		.title {
			font-size: var(--text-5xl);
		}

		.tagline {
			font-size: var(--text-lg);
		}
	}
</style>

<script is:inline>
	const el = document.getElementById('hero-typewriter');
	const text = el?.dataset?.text;
	if (!el || !text) {
		return;
	}

	const chars = text.split('');

	const animate = () => {
		if (chars.length > 0) {
			el.textContent += chars.shift();
			setTimeout(animate, 70);
		}
	};

	animate();
</script>