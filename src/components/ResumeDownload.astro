---
import Icon from './Icon.astro';
---

<a
	class="resume-download"
	href="/ManuelGorrin%20CV%20Last.pdf"
	download="ManuelGorrin-CV.pdf"
	aria-label="Download Manuel Gorrin CV"
	title="Download my CV"
>
	<Icon icon="download" size="1.4em" />
	<span>Download CV</span>
</a>

<style>
	.resume-download {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 10000;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.8rem 1.1rem;
		border: 1px solid var(--accent2-light);
		border-radius: var(--radius-full);
		color: var(--accent-text-over);
		background: var(--gradient-accent-orange);
		box-shadow: var(--shadow-lg), var(--shadow-glow-cyan);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		animation: resume-pulse 3s ease-in-out infinite;
		transition: transform var(--hover-transition), box-shadow var(--hover-transition);
	}

	.resume-download:hover,
	.resume-download:focus-visible {
		transform: translateY(-3px) scale(1.03);
		box-shadow: var(--shadow-lg), var(--shadow-glow-cyan), var(--shadow-glow);
	}

	.resume-download:active {
		transform: translateY(0) scale(0.98);
	}

	@keyframes resume-pulse {
		0%,
		100% {
			box-shadow: var(--shadow-lg), var(--shadow-glow-cyan);
		}
		50% {
			box-shadow: var(--shadow-lg), 0 0 28px hsla(187, 92%, 69%, 0.4);
		}
	}

	@media (max-width: 30em) {
		.resume-download {
			right: 1rem;
			bottom: 1rem;
			padding: 0.8rem;
		}

		.resume-download span {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.resume-download {
			animation: none;
		}
	}

	@media (forced-colors: active) {
		.resume-download {
			color: ButtonText;
			background: ButtonFace;
			border-color: ButtonText;
			box-shadow: none;
		}
	}
</style>
